# Database (PostgreSQL)
#
# --- Supabase (production/staging) ---
# App runtime uses the POOLED connection (Supabase Dashboard > Connect >
# "Transaction" pooler, port 6543). Keep pgbouncer=true - Prisma requires it
# behind transaction-mode pooling:
#   DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Prisma CLI (db push / introspect) uses the DIRECT connection, port 5432:
#   DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
#
# --- Local development (docker-compose PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/garjane_news?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/garjane_news?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
SESSION_PASSWORD="your-session-password-min-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Garjane News"
NEXT_PUBLIC_APP_NAME_KN="ಗರ್ಜನೆ ನ್ಯೂಸ್"

# Email (optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Garjane News <noreply@garjanenews.com>"

# Image Upload (optional - for local storage)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""